{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blind-tuner.invalid/Candidate.schema.json",
  "title": "Candidate",
  "description": "One candidate index from the miner, columns in index order. support is the itemset's share of total slow query time. Miner to RL.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cand_id": {
      "$ref": "common.schema.json#/$defs/cand_id"
    },
    "table": {
      "$ref": "common.schema.json#/$defs/table_code"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "common.schema.json#/$defs/col_code"
      },
      "uniqueItems": true
    },
    "support": {
      "$ref": "common.schema.json#/$defs/share"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/basket_item"
          }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/template_id"
          }
        }
      },
      "required": [
        "items",
        "templates"
      ]
    }
  },
  "required": [
    "cand_id",
    "table",
    "columns",
    "support",
    "evidence"
  ]
}
