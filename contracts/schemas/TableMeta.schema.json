{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blind-tuner.invalid/TableMeta.schema.json",
  "title": "TableMeta",
  "description": "Per-table size metadata, rounded. Gateway to RL.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "table": {
      "$ref": "common.schema.json#/$defs/table_code"
    },
    "rows": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "size_mb": {
      "type": "number",
      "minimum": 0
    },
    "writes_per_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "table",
    "rows",
    "size_mb",
    "writes_per_s"
  ]
}
