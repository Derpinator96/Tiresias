{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blind-tuner.invalid/LedgerEntry.schema.json",
  "title": "LedgerEntry",
  "description": "One logged payload. canary_hits name the canary by ID and never carry its value. verdict is block when any hit was found; a blocked payload is never sent. Gateway to privacy panel.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload_id": {
      "$ref": "common.schema.json#/$defs/payload_id"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "destination": {
      "enum": [
        "ai",
        "llm",
        "local_scanner"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canary_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canary_id": {
            "$ref": "common.schema.json#/$defs/canary_id"
          },
          "match": {
            "enum": [
              "exact",
              "fragment"
            ]
          }
        },
        "required": [
          "canary_id",
          "match"
        ]
      }
    },
    "verdict": {
      "enum": [
        "allow",
        "block"
      ]
    }
  },
  "required": [
    "payload_id",
    "time",
    "destination",
    "bytes",
    "sha256",
    "canary_hits",
    "verdict"
  ]
}
