# Copy to .env, or run `make keygen` to generate it. Never commit .env.
BT_HMAC_KEY=<64 hex chars from make keygen>
POSTGRES_PASSWORD=<random, from make keygen>
GEMINI_API_KEY=<your Gemini API key>
NVIDIA_API_KEY=<your NVIDIA API key from build.nvidia.com>
OPENAI_API_KEY=<your OpenAI API key from platform.openai.com>
